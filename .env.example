# Copy to .env and fill in. .env is gitignored. NEVER commit real values.

# PayPal SANDBOX app credentials (developer.paypal.com -> Apps & Credentials -> Sandbox).
# The app must belong to a sandbox BUSINESS account whose country is United States:
# Payouts is not available to senders in every country.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Needed when REVIEWERS=claude (real photo reviewers) and for the npm run eval:* commands.
ANTHROPIC_API_KEY=

# Optional. See the Configuration table in README.md.
# MODE=sandbox            # mock (default) or sandbox
# REVIEWERS=claude        # demo (default, simulated) or claude
# REVIEWER_MODEL_A=claude-haiku-5-5
# REVIEWER_MODEL_B=claude-haiku-5-5
# PORT=3000
# PUBLIC_URL=http://localhost:3000
# VERIFIER_KEY=
